 Documentation/arm/sprd/lima-sc7730se.txt | 66 ++++++++++++++++++++++++
 arch/arm/boot/dts/scx30g2-lima-gpu.dtsi  | 61 ++++++++++++++++++++++
 2 files changed, 127 insertions(+)
 create mode 100755 Documentation/arm/sprd/lima-sc7730se.txt
 create mode 100755 arch/arm/boot/dts/scx30g2-lima-gpu.dtsi

diff --git a/Documentation/arm/sprd/lima-sc7730se.txt b/Documentation/arm/sprd/lima-sc7730se.txt
